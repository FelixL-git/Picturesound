<Window x:Class="Picturesound.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Picturesound"
        xmlns:vm="clr-namespace:Picturesound.ViewModels"
        xmlns:utils="clr-namespace:Picturesound.Utils"
        mc:Ignorable="d"
        Title="Picturesound" Height="450" Width="800"
        Background="{StaticResource PrimaryBackground}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Background="{StaticResource SecondaryBackground}"
          AllowDrop="True"
          utils:DropBehavior.DropCommand="{Binding DropImageCommand}"
              Grid.Column="0">

            <Border Margin="20"
                BorderBrush="Gray"
                BorderThickness="2"
                CornerRadius="10"
                Background="{StaticResource PrimaryBackground}">

                <Grid>
                    <TextBlock Text="Bild hierher ziehen"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       Foreground="Gray"/>
                    <Image Source="{Binding ImagePath}"
                   Stretch="Uniform"
                   Margin="10"/>
                </Grid>

            </Border>
        </Grid>
        <Grid Grid.Column="1">
            <ScrollViewer>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Button Command="{Binding ToggleIsPlayingCommand}" Content="{Binding IsPlayingText}" Cursor="Hand">
                       
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
